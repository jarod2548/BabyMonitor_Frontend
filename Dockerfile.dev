# Development stage: run Vite dev server
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server in host mode so it’s reachable from host
CMD ["npm", "run", "dev", "--", "--host"]